# ══════════════════════════════════════════════════════
# proy_petition-cauce — variables de entorno
# Copiar a .env (producción) o .env.dev (desarrollo local)
# ─────────────────────────────────────────────────────
# REGLAS DE SEGURIDAD — leer antes de completar:
#
# 1. NUNCA commitear .env ni .env.dev (están en .gitignore)
# 2. Los valores se agregan MANUALMENTE — nunca compartir
#    este archivo con valores reales con Claude, GitHub u
#    otro sistema externo.
# 3. Los secretos de PRODUCCIÓN deben ser DIFERENTES a los
#    de desarrollo y generados por separado con openssl.
# 4. En LOCAL (.env.dev) usar claves de TEST de Cloudflare
#    Turnstile (ver sección TURNSTILE abajo).
# ══════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────
# Admin (petition_admin) — usado por Alembic para migraciones (bypasea RLS)
# Generar contraseña con: openssl rand -hex 16
POSTGRES_ADMIN_USER=petition_admin
POSTGRES_ADMIN_PASSWORD=
# App (petition_app) — usuario de runtime, no superusuario (RLS activo)
# Debe coincidir con la contraseña en DATABASE_URL
# Se pasa al contenedor postgres para que init.sh cree el usuario correctamente
PETITION_APP_PASSWORD=

# App (petition_app) — no-superusuario para el runtime de FastAPI (RLS activo)
# DATABASE_URL usa petition_app → RLS se aplica
# DATABASE_URL_SYNC usa petition_admin → Alembic puede crear/modificar tablas
# Los passwords deben ser distintos entre sí y distintos en dev vs prod.
DATABASE_URL=postgresql+asyncpg://petition_app:<password_app>@petition-db:5432/petition_cause
DATABASE_URL_SYNC=postgresql+psycopg2://petition_admin:<password_admin>@petition-db:5432/petition_cause

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://petition-redis:6379/0

# ── Seguridad API ──────────────────────────────────────
# Generar con: openssl rand -hex 32
# Usar valores DISTINTOS a los de proy_forms-qsm y distintos entre dev y prod.
JWT_SECRET_KEY=
HMAC_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Cloudflare Turnstile ───────────────────────────────
# PRODUCCIÓN: claves reales del widget Non-interactive "petition-cauce-mvp"
#   obtenidas manualmente en dash.cloudflare.com → Turnstile
# DESARROLLO LOCAL (.env.dev): usar claves de TEST oficiales de Cloudflare
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   (estas claves siempre pasan; no hacen requests reales a CF)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── URLs públicas ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://cauce.ecuadornotlc.org
NEXT_PUBLIC_API_URL=https://cauce.ecuadornotlc.org/api
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── App ────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
API_PORT=8011
WEB_PORT=3002
CORS_ORIGINS=["https://cauce.ecuadornotlc.org"]

# ── API interna (Docker service name) ─────────────────
API_INTERNAL_URL=http://petition-api:8000

# ── LOPDP — Encargado del tratamiento ─────────────────
# "natural" para persona natural; "juridica" para entidad.
# Hasta que Cauce Petition tenga SAS, usar "natural".
ENCARGADO_TIPO=natural
ENCARGADO_NOMBRE=
ENCARGADO_CEDULA_RUC=
# Solo si encargado_tipo=juridica:
ENCARGADO_REP_NOMBRE=
ENCARGADO_DOMICILIO=
ENCARGADO_EMAIL=

# ── Email (Resend) ─────────────────────────────────────
# Obtener en resend.com → API Keys
# Usar clave de TEST en desarrollo, clave de producción en prod.
RESEND_API_KEY=
